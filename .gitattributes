# Auto detect text files and perform LF normalization
* text=auto

# Los scripts de shell SIEMPRE con LF (CRLF rompe bash en Linux/WSL)
*.sh text eol=lf

# El LEEME del release Linux viaja en el tarball: que no le entre CRLF
docs/LEEME-Linux.txt text eol=lf

# Los .bat SIEMPRE con CRLF: con LF, cmd falla al saltar a etiquetas (goto)
*.bat text eol=crlf
